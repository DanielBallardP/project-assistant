# LLM settings
PA_LLM_BASE_URL=http://localhost:1234/v1
PA_LLM_MODEL=qwen3-14b-claude-4.5-opus-high-reasoning-distill
PA_REASONING_LEVEL=high

# Embedding settings
PA_EMBEDDING_MODEL=text-embedding-bge-m3
PA_EMBEDDING_QUERY_PREFIX=
PA_EMBEDDING_DOCUMENT_PREFIX=

# RAG settings
PA_CHROMA_PATH=data/chroma
PA_COLLECTION_NAME=docs

#Chunking strategy settings
# Optional overrides for the built-in min / max chars:
#PA_CHUNK_MIN_CHARS=250
#PA_CHUNK_MAX_CHARS=900